DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pfa_db?schema=public"
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# Vidog service must bind to 127.0.0.1 only; enable only once it is running.
BIOMETRIC_ENABLED=false
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000
BIOMETRIC_REGISTER_TIMEOUT_MS=600000
BIOMETRIC_IDENTIFY_TIMEOUT_MS=60000
BIOMETRIC_MAX_ATTEMPTS=3
